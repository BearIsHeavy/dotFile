#! /bin/expect

# this file will be used to connecte remote ssh
set ipAddress ""
set hostName ""
set Password ""

set patter [lindex $argv 0]
set file [lindex $argv 1]

spawn scp $patter $file $hostName@$ipAddress:~/Download
expect {
    "yes/on" {
        send "yes\r"
        exp_continue
    }
    "password:" {
        send "$Password\r"
    }
}
interact
