#!/bin/env bash

RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
BLUE="\033[0;34m"
RESET="\033[0m"

test_connection()
{
    open=$(nmap -Pn -p 8000 192.168.192.1 | grep -Eio 'open')
    if [[ -z $open ]];then
        echo "Disconnection, may be your Ai server not running" && exit 2
    fi
}

test_connection
clear

echo "type Stop exit(输入Stop退出)"

while true;
do
    echo -e -n "${RED}🐻:${RESET}${YELLOW}AI小熊${RESET} ${RED}>${RESET}${GREEN}>${RESET}${BLUE}>${RESET} " && read -r question
    response=$(curl -sS -X POST "http://192.168.192.1:8000" \
    -H 'Content-Type: application/json' \
    -d "{\"prompt\": \"$question\", \"history\": []}")
    echo -ne "${RED}🤖${RESET}: "
    echo -e "$response\n" | sed 's/{"response":"//g' | sed 's/"}//g'
done



