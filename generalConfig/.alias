alias ..='cd ..'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
alias mkdir='mkdir -p'
alias rm='rm -i'
alias mv='mv -i'

# script
alias sshMount='$HOME/bin/mount.sh'
alias uninstallApp='$HOME/bin/uninstall_mac_app.sh'


# relative network operations
alias getip='(curl --max-time 5 https://ipinfo.io/ip) || echo "Link network failure"'
alias sshAgent='eval $(ssh-agent) && ssh-add --apple-use-keychain ~/.ssh/id_ed25519'
alias setProxy='eval $(bash $HOME/bin/enableProxy.sh)'
alias unsetProxy='unset all_proxy && unset http_proxy && unset https_proxy && unset sockets_proxy'

# ls commands
# Note: On macOS M4, install eza via: brew install eza
if type eza > /dev/null;then
  alias ll='eza --all --long --icons'
  alias ltree="eza -all --tree --icons -I '.git|.vscode|__pycache__' --git-ignore"
  alias lt='eza --long --sort=time --reverse'
  alias la='eza --all'
  alias ls='eza --icons'
else
  # CHANGED: macOS native ls configuration
  alias ls='/bin/ls -G' 
  alias la='ls -a'
  alias ll='ls -al'
  alias lt='ls -alt'
fi

alias wsl='ssh bear@win11.local -p 2222'
alias vmware='ssh bear@win11.local -p 2223'
