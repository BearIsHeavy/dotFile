alias ..='cd ..'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
alias mkdir='mkdir -p'
alias rm='rm -i'
alias mv='mv -i'

# Custom script for daily work
alias publicIp='(curl --max-time 5 https://ipinfo.io/ip) || echo "Link network failure"'
alias setProxy='bash $HOME/bin/enableProxy && source $HOME/tmp.txt && rm -f $HOME/tmp.txt && echo -n "proxy has been Open"'
alias sshAgent='eval $(ssh-agent) && ssh-add'
alias unsetProxy='unset all_proxy && unset http_proxy && unset https_proxy && unset sockets_proxy'
alias cli='iflow'
# Custom curl with specific OpenSSL — uncomment and adjust path for your system
# alias e-curl='LD_LIBRARY_PATH=/home/bear/code/openssl /home/bear/code/curl/src/curl'

# ls commands
if type eza > /dev/null;then
  alias ll='eza --all --long --group --icons'
  alias ltree="eza -all --tree --icons -I '.git|.vscode|__pycache__' --git-ignore"
  alias lt='eza --long --sort=time --reverse'
  alias la='eza --all'
  alias ls='eza --icons'
elif type exa > /dev/null;then
  alias ll='exa --all --long --group --icons'
  alias ltree="exa -all --tree --icons -I '.git|.vscode|__pycache__' "
  alias lt='exa --oneline --sort=time --reverse'
  alias la='exa --all'
  alias ls='exa --icons'
else
  alias ls='/bin/ls --color=auto'
  alias la='ls -a'
  alias ll='ls -al'
  alias lt='ls -alt'
fi
