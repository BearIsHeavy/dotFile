#alias rm='rm -i'
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ..='cd ..'
alias .='cd .'
alias mkdir='mkdir -p'
alias rm='rm -i'
alias mv='mv -i'
alias ll='ls -Alh'
alias la='ls -A'
alias l='ls -CF'
alias tree='tree -a'
alias setProxy='https_proxy=http://172.21.32.1:7890;export http_proxy=http://172.21.32.1:7890;export all_proxy=socks5://172.21.32.1:7890'
alias virtualEnv='source ~/Bear/bin/activate'
