    //下面自己配置

    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.hlsearch": true,

    "vim.insertModeKeyBindings": [
        {
            "before": ["<C-l>"],
            "after": ["<End>"]
        }
    ],

    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["<leader>", "d"],
            "after": ["d", "d"]
        },
        {//自己设置的光标后移
            "before": ["<C-l>"],
            "after": ["$"]
        },
        {
            "before": ["<C-k>"],
            "commands": ["lineBreakInsert"],
            "silent": true
        }
    ],

    "vim.leader": "<space>",
    "vim.handleKeys": {
        "<C-a>": false,
        "<C-f>": false
    },
