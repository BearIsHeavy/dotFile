alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ..='cd ..'
alias .='cd .'
alias mkdir='mkdir -p'
alias rm='rm -i'
alias mv='mv -i'
alias ll='exa --header --all --oneline --long'
alias ltree="exa --tree -I '.git|.vscode|__pycache__' "
alias la='ls --color=auto -A'
alias lt='exa --oneline --sort=time'
alias l='exa --oneline'
alias tree='tree -a -C'
alias publicIp='curl -s https://ipinfo.io/ip'
alias setProxy='source $HOME/bin/enableProxy'
alias sshAgent='eval $(ssh-agent) && ssh-add'
alias leetcode='cd $HOME/ACM/pythonLeetCode/ && code $_'
alias dataStruct='code $HOME/408/DataStruct'
alias Ai='~/bin/ChatAi'
alias Aienv='source ~/408/network/AI/bin/activate'

