alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ..='cd ..'
alias .='cd .'
alias mkdir='mkdir -p'
alias rm='rm -i'
alias mv='mv -i'
alias ll='ls -Alh'
alias la='ls -A'
alias l='ls -CF'
alias tree='tree -a -C'
alias virtualEnv='source ~/CNN/bin/activate'
alias publicIp='curl -s https://ipinfo.io/ip'
alias setProxy='source $HOME/bin/enableProxy'
alias sshAgent='eval $(ssh-agent) && ssh-add'
alias leetcode='cd $HOME/ACM/pythonLeetCode/ && code $_'
