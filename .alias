alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'
alias ..='cd ..'
alias mkdir='mkdir -p'
alias rm='rm -i'
alias mv='mv -i'
alias ll='exa --header --all --oneline --long --group --icons'
alias ltree="exa --tree --icons -I '.git|.vscode|__pycache__' "
alias lt='exa --oneline --sort=time --reverse'
alias la='exa --all'
alias ls='exa --icons'
alias tree='tree -a -C'
alias publicIp='curl -s https://ipinfo.io/ip'
alias setProxy='source $HOME/bin/enableProxy'
alias sshAgent='eval $(ssh-agent) && ssh-add'
alias Ai='~/bin/ChatAi'
alias Aienv='source ~/408/network/AI/bin/activate'
alias chat='/mnt/d/WeChat/WeChat.exe'
