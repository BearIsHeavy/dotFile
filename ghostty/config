# --- Font & Appearance ---
# Ensure "Maple Mono NF CN" is installed via Brew or manually
font-family = "Maple Mono NF CN"
font-size = 14

# Modern Ghostty uses 'background-opacity' and 'background-blur'
background-opacity = 0.95
background-blur = 20

# Premium macOS look
macos-titlebar-style = transparent
# Adds a slight "breathing room" for your code
window-padding-x = 10
window-padding-y = 10

# --- Window & Glass Effects (Optimized for M4 GPU) ---
background-opacity = 0.85
background-blur = 20
macos-titlebar-style = transparent
window-padding-x = 12
window-padding-y = 12

# --- Performance & Native Integration ---
# Use the M4 GPU for smooth rendering
macos-icon = official

# --- Developer Workflow (Shortcuts) ---
# Split Panes (Standard dev layout)
keybind = cmd+d=new_split:right
# Focus Navigation
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right

# --- Mouse & Selection ---
copy-on-select = clipboard
# Hides cursor while typing to keep the M4 display clean
mouse-hide-while-typing = true